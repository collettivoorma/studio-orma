---
import Base from '../../layouts/Base.astro';
import {getCollection,render} from 'astro:content';
export async function getStaticPaths(){return (await getCollection('events')).map(e=>({params:{slug:e.id},props:{e}}))}
const {e}=Astro.props;
const {Content}=await render(e);
---
<Base title={`${e.data.title} — Studio Orma`} description={e.data.excerpt}>
  <article class="detail event-detail">
    <div class="eyebrow">Mostra / Evento</div>
    <h1>{e.data.title}</h1>
    <div class="event-row">
      <span class="meta">{e.data.start.toLocaleDateString('it-IT')}</span>
      <span class="title">{e.data.artist}</span>
      <span class="where">{e.data.location}, {e.data.city}</span>
      <span class="year">{e.data.start.getFullYear()}</span>
    </div>

    {e.data.cover && <section class="event-main-media"><img src={e.data.cover} alt={e.data.title} /></section>}

    <section class="event-curatorial">
      <div class="event-section-label">DESCRIZIONE CURATORIALE</div>
      <div class="detail-grid">
        <div class="meta">
          {e.data.start.toLocaleDateString('it-IT')} {e.data.end && <>— {e.data.end.toLocaleDateString('it-IT')}</>}<br/><br/>
          {e.data.location}<br/>{e.data.city}
        </div>
        <div class="content"><Content/></div>
      </div>
    </section>

    {e.data.gallery?.length > 0 && <section class="event-gallery">
      <div class="event-section-label">GALLERIA MEDIA</div>
      <div class="event-gallery-grid">
        {e.data.gallery.map((img,i)=><img src={img} alt={`${e.data.title} — galleria ${i+1}`} />)}
      </div>
    </section>}
  </article>
</Base>
