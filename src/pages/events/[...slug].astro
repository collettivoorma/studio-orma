---
import Base from '../../layouts/Base.astro'; import {getCollection,render} from 'astro:content'; export async function getStaticPaths(){return (await getCollection('events')).map(e=>({params:{slug:e.id},props:{e}}))}; const {e}=Astro.props; const {Content}=await render(e);
---
<Base title={`${e.data.title} — Studio Orma`} description={e.data.excerpt}><article class="detail"><div class="eyebrow">Mostra / Evento</div><h1>{e.data.title}</h1><div class="event-row"><span class="meta">{e.data.start.toLocaleDateString('it-IT')}</span><span class="title">{e.data.artist}</span><span class="where">{e.data.location}, {e.data.city}</span><span class="year">{e.data.start.getFullYear()}</span></div>{e.data.cover && <img src={e.data.cover} alt={e.data.title} style="margin-top:55px;max-height:75vh;object-fit:cover"/>}<div class="detail-grid"><div class="meta">{e.data.start.toLocaleDateString('it-IT')} {e.data.end && <>— {e.data.end.toLocaleDateString('it-IT')}</>}<br><br>{e.data.location}<br>{e.data.city}</div><div class="content"><Content/></div></div>{e.data.gallery?.map(img=><img src={img} alt="" style="margin-top:5vw"/>)}</article></Base>
