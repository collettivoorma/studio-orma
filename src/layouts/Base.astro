---
import '../styles/global.css';
const {title='Studio Orma',description='Spazio indipendente per le arti contemporanee a Roma.'}=Astro.props;
---
<!doctype html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="description" content={description}>
  <title>{title}</title>
</head>
<body>
  <header class="site-header">
    <a class="orma" href="/">STUDIO ORMA</a>
    <nav aria-label="Navigazione principale">
      <a href="/">HOME</a>
      <a href="/about">ABOUT</a>
      <a href="/events">MOSTRE ED EVENTI</a>
      <a href="/journal">PRESS</a>
      <a href="/#contact">CONTATTI</a>
    </nav>
  </header>
  <main><slot/></main>
  <footer id="contact" class="contact">
    <div class="contact-title">CONTATTI</div>
    <div class="contact-grid">
      <div>
        <strong>SCRIVICI</strong>
        <p>Per qualsiasi tipo di richiesta scrivici, verrai raggiunto tempestivamente da un nostro collaboratore.</p>
        <a class="mail-big" href="mailto:collettivoorma@gmail.com">collettivoorma@gmail.com</a>
      </div>
      <div><strong>CONTATTI</strong><p>Marco: <a class="tel-link" href="tel:+393755770117">+39 375 577 0117</a><br>Edoardo: <a class="tel-link" href="tel:+393317694025">+39 331 769 4025</a></p></div>
      <div><strong>STUDIO ORMA</strong><p>Associazione ORMA<br><a class="maps-link" href="https://www.google.com/maps/place/Studio+Orma/@41.8726811,12.4484414,17z/data=!3m1!4b1!4m6!3m5!1s0x132f61001b74cf55:0xe073b60b7ef8a6f1!8m2!3d41.8726811!4d12.4510163!16s%2Fg%2F11whwslgc8?entry=ttu&g_ep=EgoyMDI2MTAxMy4wIKXMDSoASAFQAw%3D%3D" target="_blank" rel="noopener noreferrer">Via Francesco Amici, 10<br>00152 Roma (RM)<br>Italia</a></p><a class="footer-link footer-link-ig" href="https://www.google.com/maps/place/Studio+Orma/@41.8726811,12.4484414,17z/data=!3m1!4b1!4m6!3m5!1s0x132f61001b74cf55:0xe073b60b7ef8a6f1!8m2!3d41.8726811!4d12.4510163!16s%2Fg%2F11whwslgc8?entry=ttu&g_ep=EgoyMDI2MTAxMy4wIKXMDSoASAFQAw%3D%3D" target="_blank" rel="noopener noreferrer"><svg class="ig-icon" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11z"/><circle cx="12" cy="10" r="2.4"/></svg>GOOGLE MAPS ↗</a><br><a class="footer-link footer-link-ig" href="https://www.instagram.com/studioorma/" target="_blank" rel="noopener noreferrer"><svg class="ig-icon" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.4" cy="6.6" r="1" fill="currentColor" stroke="none"/></svg>INSTAGRAM ↗</a></div>
      <div class="support">
        <strong>SOSTIENICI</strong>
        <p>IBAN:<br><span class="iban">IT15J0306909606100000402202</span></p>
        <p>ASSOCIAZIONE ORMA</p>
        <a class="footer-link paypal-link" href="https://www.paypal.com/ncp/payment/69ZPY3HF6TZC6" target="_blank" rel="noopener noreferrer">DONAZIONE PAYPAL ↗</a>
      </div>
    </div>
    <div class="footer-bottom"><span>© {new Date().getFullYear()} STUDIO ORMA</span></div>
  </footer>
</body>
</html>
