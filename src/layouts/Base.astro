---
import '../styles/global.css';
const {title='Studio Orma',description='Spazio indipendente per le arti contemporanee a Roma.'}=Astro.props;
---
<!doctype html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="description" content={description}>
  <title>{title}</title>
</head>
<body>
  <header class="site-header">
    <a class="orma" href="/">STUDIO ORMA</a>
    <nav aria-label="Navigazione principale">
      <a href="/about">ABOUT</a>
      <a href="/events">MOSTRE ED EVENTI</a>
      <a href="/journal">PRESS</a>
      <a href="/#contact">CONTATTI</a>
    </nav>
  </header>
  <main><slot/></main>
  <footer id="contact" class="contact">
    <div class="contact-title">CONTATTI</div>
    <div class="contact-grid">
      <div>
        <p>Per qualsiasi tipo di richiesta scrivici.<br>Verrai raggiunto a breve da un nostro collaboratore.</p>
        <a class="mail-big" href="mailto:collettivoorma@gmail.com">collettivoorma@gmail.com</a>
      </div>
      <div><strong>CONTATTI</strong><p>Marco: +39 375 577 0117<br>Edoardo: +39 331 769 4025</p></div>
      <div><strong>STUDIO ORMA</strong><p>Associazione ORMA<br>Via Francesco Amici, 10<br>00152 Roma (RM)<br>Italia</p><a class="footer-link" href="https://www.instagram.com/studioorma/" target="_blank" rel="noopener noreferrer">INSTAGRAM ↗</a></div>
    </div>
    <div class="footer-bottom"><span>© {new Date().getFullYear()} STUDIO ORMA</span><a href="https://www.instagram.com/studioorma/" target="_blank" rel="noopener noreferrer">INSTAGRAM</a></div>
  </footer>
</body>
</html>
